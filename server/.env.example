# Server Port
PORT=5001

# Erlaubte Frontend-Origins (für Render / separate TV & Smartphone Apps)
# Komma-separiert in CORS_ORIGINS oder einzeln über TV_ORIGIN & SMARTPHONE_ORIGIN
TV_ORIGIN=http://localhost:5174
SMARTPHONE_ORIGIN=http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173
# CORS_ORIGINS=https://projektbox-tv.onrender.com,https://projektbox-smartphone.onrender.com

# Cross-Site-Cookie Modus erzwingen (bei HTTPS über getrennte Subdomains auf Render)
# CROSS_SITE_COOKIES=true

# Neon PostgreSQL (NIEMALS echte Credentials ins Repository einchecken!)
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# DIRECT_URL=postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Optional: Redis für Multi-Instanz Socket.io Adapter & Rate-Limiter
# REDIS_URL=redis://localhost:6379
